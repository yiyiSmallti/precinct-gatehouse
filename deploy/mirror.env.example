# Domestic OCI Registry credentials for Precinct Gatehouse CD on gpu1
# Copy to /AIOS/sglang-kunlun-v0522-1017/deploy-dsv41-1017/gateway/gatehouse/mirror.env
# and restrict permissions: chmod 600 mirror.env

# Examples:
#   Aliyun ACR Personal:  registry.cn-hangzhou.aliyuncs.com/<namespace>/gatehouse
#   Tencent CCR Personal: ccr.ccs.tencentyun.com/<namespace>/gatehouse
CN_REGISTRY_IMAGE=<registry-host>/<namespace>/gatehouse
CN_REGISTRY_USERNAME=<registry-username>
CN_REGISTRY_PASSWORD=<registry-password>

# Default tag when running pull-and-deploy.sh without arguments
MIRROR_TAG=latest

# Fallback UDP DNS resolvers used when /etc/resolv.conf is empty
MIRROR_DNS=223.5.5.5,119.29.29.29
